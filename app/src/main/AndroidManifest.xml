<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="ru.oneme.app" />
        <package android:name="com.samsung.knox.securefolder" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- Иконка на рабочем столе: просто запускает ru.oneme.app -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:enabled="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Анимация "выброса" (по нажатию на виджет) -->
        <activity
            android:name=".EjectActivity"
            android:exported="false"
            android:theme="@style/Eject"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <receiver android:name=".ButtonWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
